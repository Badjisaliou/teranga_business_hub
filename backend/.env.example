APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=
# Production CORS:
# FRONTEND_URL and ADMIN_FRONTEND_URL must be the primary production domains.
# Add extra explicit public origins in CORS_ALLOWED_ORIGINS, separated by commas.
# Example: CORS_ALLOWED_ORIGINS=https://terangabusinesshub.com,https://www.terangabusinesshub.com
# Do not use localhost, preview deployments, wildcards, or trailing slashes in production.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
API_TOKEN_TTL_MINUTES=10080

# Production guardrails:
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=info
# DB_CONNECTION=pgsql
# DEXPAY_ENABLED=true
# DEXPAY_MODE=live
# DEXPAY_AUTO_CONFIRM_DEV=false

MOBILE_MONEY_MODE=dev
MOBILE_MONEY_AUTO_CONFIRM_DEV=true
MOBILE_MONEY_WEBHOOK_SECRET=change-me
MOBILE_MONEY_SIGNATURE_HEADER=X-MobileMoney-Signature
MOBILE_MONEY_TIMESTAMP_HEADER=X-MobileMoney-Timestamp
MOBILE_MONEY_ENFORCE_TIMESTAMP=true
MOBILE_MONEY_MAX_SKEW_SECONDS=300
MOBILE_MONEY_REPLAY_TTL_SECONDS=600
MOBILE_MONEY_WEBHOOK_URL=http://localhost:8000/api/webhook/mobile-money

WAVE_BASE_URL=https://api.wave.com
WAVE_API_KEY=

ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_API_KEY=

DEXPAY_ENABLED=false
DEXPAY_MODE=sandbox
DEXPAY_AUTO_CONFIRM_DEV=true
DEXPAY_PENDING_EXPIRATION_HOURS=24
DEXPAY_PUBLIC_KEY=pk_test_xxx
DEXPAY_SECRET_KEY=sk_test_xxx
DEXPAY_WEBHOOK_SECRET=
DEXPAY_SIGNATURE_HEADER=X-Dexchange-Signature
DEXPAY_CURRENCY=XOF
DEXPAY_COUNTRY_ISO=SN
DEXPAY_WEBHOOK_URL=http://localhost:8000/api/webhook/dexpay
DEXPAY_SUCCESS_URL=http://localhost:3000/paiement/retour
DEXPAY_FAILURE_URL=http://localhost:3000/paiement/annule
ADHESION_APPLICATION_EXPIRATION_HOURS=24
ADHESION_ABANDONED_RETENTION_DAYS=30

ADMIN_PORTAL_REGISTRATION_SECRET=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
MEMBER_COOKIE_NAME=tbh_member_session
ADMIN_COOKIE_NAME=tbh_admin_session
API_COOKIE_DOMAIN=null
API_COOKIE_SECURE=false
API_COOKIE_SAME_SITE=lax
# Production cross-site actuelle : noms __Host-tbh_member_session et __Host-tbh_admin_session, API_COOKIE_SECURE=true, API_COOKIE_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
NOTIFICATIONS_EMAIL_ENABLED=false
